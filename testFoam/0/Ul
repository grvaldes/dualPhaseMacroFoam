FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ul;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    Inlet
    {
        // type            zeroGradient;
        //type                flowRateInletVelocity;
        //volumetricFlowRate  constant 20000;
        type            fixedValue;
        // value               uniform (0 0 0);
        value           uniform (0.2 0 0);
    }
    Outlet
    {
        type            zeroGradient;
    }
    Walls
    {
        type            zeroGradient;
    }FrontAndBack
    {
        type            empty;
    }
}


