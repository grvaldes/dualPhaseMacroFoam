FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    //class       volTensorField;
    location    "0";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 2 0 0 0 0 0 ];

Kx 1e-8;
//internalField   uniform ( $Kx 0 0 0 $Kx 0 0 0 $Kx );
internalField   uniform $Kx;

boundaryField
{
    Inlet
    {
        type            zeroGradient;
    }
    Outlet
    {
        type            zeroGradient;
    }
    Walls
    {
        type            zeroGradient;
    }
    FrontAndBack
    {
        type            empty;
    }
}


